{
  "name": "EMB R7 Planning",
  "dataColors": [
    "#0F3D2E",
    "#0891B2",
    "#C9992E",
    "#16A34A",
    "#D97706",
    "#DC2626",
    "#94A3B8",
    "#1F7A55"
  ],
  "background": "#FFFFFF",
  "foreground": "#17211D",
  "tableAccent": "#14563F",
  "good": "#16A34A",
  "neutral": "#D97706",
  "bad": "#DC2626",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "fontFace": "Segoe UI Semibold",
      "color": "#17211D"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#17211D"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#6B7F77"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#3A4A44"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCE7E1"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F7F5"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F3F7F5"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 26,
            "fontFace": "Segoe UI Semibold",
            "color": {
              "solid": {
                "color": "#17211D"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "fontSize": 9,
            "fontFace": "Segoe UI",
            "color": {
              "solid": {
                "color": "#6B7F77"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCE7E1"
              }
            },
            "radius": 8
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#6B7F77"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 9
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#17211D"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#6B7F77"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F3F7F5"
              }
            },
            "fontSize": 9,
            "bold": true
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#17211D"
              }
            },
            "fontSize": 9
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EDF2EF"
              }
            },
            "rowPadding": 3
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "lineStyle": "solid",
            "showMarker": false
          }
        ],
        "labels": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#6B7F77"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#6B7F77"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#EDF2EF"
              }
            },
            "gridlineStyle": "solid",
            "gridlineThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#3A4A44"
              }
            }
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#3A4A44"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#6B7F77"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#EDF2EF"
              }
            }
          }
        ],
        "labels": [
          {
            "show": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#3A4A44"
              }
            }
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#3A4A44"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#6B7F77"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#EDF2EF"
              }
            }
          }
        ],
        "labels": [
          {
            "show": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#3A4A44"
              }
            }
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Right",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#3A4A44"
              }
            }
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9
          }
        ]
      }
    }
  }
}
